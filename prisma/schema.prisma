generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  password_hash String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  preferences     UserPreference?
  contextAccesses ContextAccess[]
  roles           UserRole[]
  activityLogs    ActivityLog[]
  notifications   Notification[]

  institutionMemberships InstitutionMember[]
  startupMemberships     StartupMember[]
  mentorProfile          Mentor?
  entrepreneurProfile    EntrepreneurProfile?
  actionPlans            ActionPlan[]
  evaluatedForms         FormSubmission[]
  founderProfile         Founder?
  communityPosts         CommunityPost[]
  communityComments      CommunityComment[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  user_id String
  role_id String

  user User @relation(fields: [user_id], references: [id])
  role Role @relation(fields: [role_id], references: [id])

  @@id([user_id, role_id])
}

model RolePermission {
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
}

model Institution {
  id          String   @id @default(uuid())
  name        String
  logo        String?
  description String?
  status      String   @default("ACTIVE")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  members  InstitutionMember[]
  programs Program[]
  startups StartupInstitution[]
}

model InstitutionMember {
  id             String      @id @default(uuid())
  institution_id String
  user_id        String
  role           String
  status         String      @default("ACTIVE")
  institution    Institution @relation(fields: [institution_id], references: [id])
  user           User        @relation(fields: [user_id], references: [id])
}

model Program {
  id             String      @id @default(uuid())
  institution_id String
  name           String
  description    String?
  start_date     DateTime?
  end_date       DateTime?
  status         String      @default("ACTIVE")
  // GARAGE 2026 extended fields
  program_type   String? // ACELERACAO, INCUBACAO, MENTORIA, CAPACITACAO
  cohort         String? // Ex: "2026-01"
  cover_url      String?
  institution    Institution @relation(fields: [institution_id], references: [id])

  startups StartupProgram[]
  journeys Journey[]
  founders Founder[]
}

model Startup {
  id                     String  @id @default(uuid())
  name                   String
  logo                   String?
  description_short      String?
  description_long       String?
  segment                String?
  sector                 String?
  stage                  String?
  status                 String  @default("ACTIVE")
  cnpj                   String?
  city                   String?
  state                  String?
  country                String?
  website                String?
  linkedin               String?
  instagram              String?
  email                  String?
  phone                  String?
  problem                String?
  solution               String?
  target_audience        String?
  value_proposition      String?
  business_model         String?
  revenue_sources        String?
  market_size            String?
  competitors            String?
  competitive_advantages String?
  tech_used              String?
  maturity_level         String?
  traction               String?
  core_metrics           String?
  pitch_short            String?
  pitch_long             String?
  pitch_deck_url         String?
  notes                  String?
  tags                   String?

  // Minha Startup fields
  vision        String?
  mission       String?
  values        String?
  avg_ticket    String?
  brand_purpose String?

  created_by String?
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  members      StartupMember[]
  institutions StartupInstitution[]
  programs     StartupProgram[]
  mentors      MentorStartup[]

  journeyProgresses     StartupJourneyProgress[]
  tasks                 Task[]
  diagnostics           StartupDiagnostic[]
  feedbacks             StartupFeedback[]
  metrics               StartupMetric[]
  reports               StartupReport[]
  documents             StartupDocument[]
  financials            FinancialTransaction[]
  contracts             Contract[]
  goals                 Goal[]
  canvasData            CanvasData?
  leads                 Lead[]
  agendaEvents          AgendaEvent[]
  turmaEnrollments      TurmaEnrollment[]
  disciplinaEnrollments DisciplinaEnrollment[]
  formSubmissions       FormSubmission[]
}

model CanvasData {
  id                String  @id @default(uuid())
  startup_id        String  @unique
  // Lean Canvas
  lean_problem      String?
  lean_solution     String?
  lean_value        String?
  lean_advantage    String?
  lean_segments     String?
  lean_channels     String?
  lean_metrics      String?
  lean_costs        String?
  lean_revenue      String?
  // Business Model Canvas
  bmc_partners      String?
  bmc_activities    String?
  bmc_resources     String?
  bmc_value         String?
  bmc_customer_rel  String?
  bmc_channels      String?
  bmc_segments      String?
  bmc_costs         String?
  bmc_revenue       String?
  // Value Proposition
  vp_gain_creators  String?
  vp_products       String?
  vp_pain_relievers String?
  vp_customer_gains String?
  vp_customer_jobs  String?
  vp_customer_pains String?
  // Personas (JSON array)
  personas          String?
  // Pitch
  pitch_problem     String?
  pitch_solution    String?
  pitch_market      String?
  pitch_model       String?
  pitch_traction    String?
  pitch_team        String?
  pitch_ask         String?

  updated_at DateTime @updatedAt
  startup    Startup  @relation(fields: [startup_id], references: [id])
}

model Turma {
  id          String    @id @default(uuid())
  name        String
  description String?
  start_date  DateTime?
  end_date    DateTime?
  status      String    @default("ACTIVE") // ACTIVE, FINISHED, DRAFT
  cover_url   String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  disciplinas TurmaDiscip[]
  enrollments TurmaEnrollment[]
  mentorias   MentoriaTurma[]
}

model TurmaDiscip {
  id               String   @id @default(uuid())
  turma_id         String? // Optional now, if null it's a global discipline
  name             String
  description      String?
  order            Int      @default(0)
  duration_h       Int?
  content_url      String?
  payment_type     String   @default("FREE") // FREE, BOLETO, MENSALIDADE
  price            Float?
  is_global        Boolean  @default(false) // If true, available to all startups regardless of turma
  status           String   @default("ACTIVE") // ACTIVE, INACTIVE
  support_material String? // JSON or URL
  mentors_info     String? // JSON or text about mentors/consultants
  created_at       DateTime @default(now())

  turma       Turma?                 @relation(fields: [turma_id], references: [id])
  enrollments DisciplinaEnrollment[]
}

model TurmaEnrollment {
  id             String    @id @default(uuid())
  turma_id       String
  startup_id     String
  status         String    @default("ACTIVE") // ACTIVE, COMPLETED, SUSPENDED
  payment_status String    @default("PENDING") // PENDING, PAID, FREE
  enrolled_at    DateTime  @default(now())
  completed_at   DateTime?
  diploma_issued Boolean   @default(false)
  diploma_url    String?

  turma   Turma   @relation(fields: [turma_id], references: [id])
  startup Startup @relation(fields: [startup_id], references: [id])
}

model DisciplinaEnrollment {
  id             String    @id @default(uuid())
  disciplina_id  String
  startup_id     String
  progress       Float     @default(0)
  grade          Float? // Nota
  attendance     Float? // Frequência %
  status         String    @default("ENROLLED") // ENROLLED, PASSED, FAILED
  payment_status String    @default("FREE") // PENDING, PAID, FREE
  completed_at   DateTime?

  disciplina TurmaDiscip @relation(fields: [disciplina_id], references: [id])
  startup    Startup     @relation(fields: [startup_id], references: [id])
}

// ─── FORMS / DUE DILIGENCE ──────────────────────────────────────────

model FormTemplate {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String   @default("DUE_DILIGENCE") // DUE_DILIGENCE, MENTORING, FEEDBACK
  created_at  DateTime @default(now())

  fields      FormField[]
  submissions FormSubmission[]
}

model FormField {
  id          String  @id @default(uuid())
  template_id String
  label       String
  type        String // TEXT, TEXTAREA, RATING, BOOLEAN, SELECT
  options     String? // JSON array for select options
  required    Boolean @default(true)
  order       Int     @default(0)

  template FormTemplate      @relation(fields: [template_id], references: [id])
  answers  FormFieldAnswer[]
}

model FormSubmission {
  id           String   @id @default(uuid())
  template_id  String
  startup_id   String
  evaluator_id String? // ID of mentor/admin who evaluated (if applicable)
  status       String   @default("SUBMITTED") // DRAFT, SUBMITTED, REVIEWED
  created_at   DateTime @default(now())

  template  FormTemplate      @relation(fields: [template_id], references: [id])
  startup   Startup           @relation(fields: [startup_id], references: [id])
  evaluator User?             @relation(fields: [evaluator_id], references: [id])
  answers   FormFieldAnswer[]
}

model FormFieldAnswer {
  id            String  @id @default(uuid())
  submission_id String
  field_id      String
  value         String? // Can be text, number, etc.

  submission FormSubmission @relation(fields: [submission_id], references: [id])
  field      FormField      @relation(fields: [field_id], references: [id])
}

model MentoriaTurma {
  id           String   @id @default(uuid())
  turma_id     String
  mentor_id    String
  scheduled_at DateTime
  duration_min Int      @default(60)
  topic        String?
  meet_url     String?
  status       String   @default("SCHEDULED") // SCHEDULED, DONE, CANCELLED
  notes        String?
  created_at   DateTime @default(now())

  turma  Turma  @relation(fields: [turma_id], references: [id])
  mentor Mentor @relation(fields: [mentor_id], references: [id])
}

model StartupMember {
  id          String    @id @default(uuid())
  startup_id  String
  user_id     String
  role        String
  permissions String? // JSON string or comma-separated
  status      String    @default("ACTIVE")
  invited_by  String?
  joined_at   DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  startup Startup @relation(fields: [startup_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])
}

model StartupInstitution {
  id                String   @id @default(uuid())
  startup_id        String
  institution_id    String
  status            String   @default("ACTIVE")
  relationship_type String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  startup     Startup     @relation(fields: [startup_id], references: [id])
  institution Institution @relation(fields: [institution_id], references: [id])
}

model StartupProgram {
  id         String    @id @default(uuid())
  startup_id String
  program_id String
  status     String    @default("ACTIVE")
  entry_date DateTime?
  exit_date  DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  startup Startup @relation(fields: [startup_id], references: [id])
  program Program @relation(fields: [program_id], references: [id])
}

model Mentor {
  id                  String          @id @default(uuid())
  user_id             String          @unique
  bio                 String?
  expertise           String?
  verification_status String          @default("PENDING") // PENDING, VERIFIED, SUSPENDED
  impact_score        Float?          @default(0)
  total_hours         Int?            @default(0)
  user                User            @relation(fields: [user_id], references: [id])
  startups            MentorStartup[]
  mentorias           MentoriaTurma[]
}

model EntrepreneurProfile {
  id         String  @id @default(uuid())
  user_id    String  @unique
  startup_id String?

  // Diagnóstico Comportamental
  coachability    Float? @default(0)
  execution_speed Float? @default(0)
  resilience      Float? @default(0)
  leadership      Float? @default(0)

  // KPIs de Fato (Individuais)
  technical_score  Float? @default(0)
  commercial_score Float? @default(0)

  // Semelhanças e Análise de Equipe
  personality_type String? // Ex: Executor, Visionário, Analítico
  team_fit_score   Float?  @default(0)
  similarity_notes String?

  is_verified Boolean @default(false)
  notes       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])
}

model MentorStartup {
  id         String  @id @default(uuid())
  mentor_id  String
  startup_id String
  status     String  @default("ACTIVE")
  mentor     Mentor  @relation(fields: [mentor_id], references: [id])
  startup    Startup @relation(fields: [startup_id], references: [id])

  mentorships Mentorship[]
}

model Journey {
  id          String        @id @default(uuid())
  program_id  String
  name        String
  description String?
  program     Program       @relation(fields: [program_id], references: [id])
  steps       JourneyStep[]
}

model JourneyStep {
  id          String  @id @default(uuid())
  journey_id  String
  title       String
  description String?
  order       Int
  journey     Journey @relation(fields: [journey_id], references: [id])

  startupProgresses StartupJourneyProgress[]
}

model StartupJourneyProgress {
  id              String      @id @default(uuid())
  startup_id      String
  journey_step_id String
  library_item_id String?
  status          String      @default("PENDING")
  completed_at    DateTime?
  startup         Startup     @relation(fields: [startup_id], references: [id])
  step            JourneyStep @relation(fields: [journey_step_id], references: [id])
}

model CommunityPost {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  content    String
  category   String   @default("Geral")
  tags       String?  // Comma-separated tags
  likes      Int      @default(0)
  created_at DateTime @default(now())

  comments   CommunityComment[]

  @@map("community_posts")
}

model CommunityComment {
  id         String   @id @default(uuid())
  post_id    String
  user_id    String
  content    String
  created_at DateTime @default(now())

  post CommunityPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("community_comments")
}

model Task {
  id          String    @id @default(uuid())
  startup_id  String
  title       String
  description String?
  due_date    DateTime?
  status      String    @default("TODO") // TODO, IN_PROGRESS, DONE, BLOCKED
  order       Int       @default(0)
  assigned_to String?

  startup Startup @relation(fields: [startup_id], references: [id])
}

model Goal {
  id          String    @id @default(uuid())
  startup_id  String
  title       String
  description String?
  target_date DateTime?
  status      String    @default("PENDING") // PENDING, ACHIEVED, FAILED
  created_at  DateTime  @default(now())

  startup     Startup      @relation(fields: [startup_id], references: [id])
  actionPlans ActionPlan[]
}

model ActionPlan {
  id             String    @id @default(uuid())
  goal_id        String
  description    String
  responsible_id String
  due_date       DateTime?
  status         String    @default("PENDING")

  goal        Goal @relation(fields: [goal_id], references: [id])
  responsible User @relation(fields: [responsible_id], references: [id])
}

model FinancialTransaction {
  id          String   @id @default(uuid())
  startup_id  String
  description String
  amount      Float
  type        String // INCOME, EXPENSE
  category    String?
  date        DateTime @default(now())

  startup Startup @relation(fields: [startup_id], references: [id])
}

model Contract {
  id         String   @id @default(uuid())
  startup_id String
  title      String
  type       String // CLIENT, PARTNERSHIP, SOCIETARY, OTHER
  url        String?
  file_url   String? // For PDF attachments
  status     String   @default("ACTIVE")
  created_at DateTime @default(now())

  startup Startup @relation(fields: [startup_id], references: [id])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  description String
  type        String // EVENT, EDITAL
  start_date  DateTime?
  end_date    DateTime?
  link        String?
  created_at  DateTime  @default(now())
}

model Diagnostic {
  id          String               @id @default(uuid())
  title       String
  description String?
  questions   DiagnosticQuestion[]
  startups    StartupDiagnostic[]
}

model DiagnosticQuestion {
  id            String     @id @default(uuid())
  diagnostic_id String
  question      String
  type          String
  diagnostic    Diagnostic @relation(fields: [diagnostic_id], references: [id])
}

model StartupDiagnostic {
  id            String     @id @default(uuid())
  startup_id    String
  diagnostic_id String
  status        String     @default("PENDING")
  score         Float?
  startup       Startup    @relation(fields: [startup_id], references: [id])
  diagnostic    Diagnostic @relation(fields: [diagnostic_id], references: [id])
}

model Mentorship {
  id                String   @id @default(uuid())
  mentor_startup_id String
  date              DateTime
  summary           String?
  status            String   @default("SCHEDULED")

  mentorStartup MentorStartup    @relation(fields: [mentor_startup_id], references: [id])
  feedbacks     MentorFeedback[]
}

model MentorFeedback {
  id            String     @id @default(uuid())
  mentorship_id String
  feedback_text String
  rating        Int?
  mentorship    Mentorship @relation(fields: [mentorship_id], references: [id])
}

model StartupFeedback {
  id            String   @id @default(uuid())
  startup_id    String
  author_id     String
  feedback_text String
  created_at    DateTime @default(now())

  startup Startup @relation(fields: [startup_id], references: [id])
}

model Metric {
  id          String          @id @default(uuid())
  name        String
  description String?
  startups    StartupMetric[]
}

model StartupMetric {
  id         String   @id @default(uuid())
  startup_id String
  metric_id  String
  value      String
  date       DateTime @default(now())

  startup Startup @relation(fields: [startup_id], references: [id])
  metric  Metric  @relation(fields: [metric_id], references: [id])
}

model Report {
  id       String          @id @default(uuid())
  title    String
  type     String
  startups StartupReport[]
}

model StartupReport {
  id         String @id @default(uuid())
  startup_id String
  report_id  String
  url        String

  startup Startup @relation(fields: [startup_id], references: [id])
  report  Report  @relation(fields: [report_id], references: [id])
}

model Document {
  id       String            @id @default(uuid())
  name     String
  type     String
  url      String
  startups StartupDocument[]
}

model StartupDocument {
  id          String @id @default(uuid())
  startup_id  String
  document_id String

  startup  Startup  @relation(fields: [startup_id], references: [id])
  document Document @relation(fields: [document_id], references: [id])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
}

model ActivityLog {
  id          String   @id @default(uuid())
  user_id     String
  action      String
  entity_type String
  entity_id   String
  details     String?
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
}

model UserPreference {
  id                         String  @id @default(uuid())
  user_id                    String  @unique
  // Add preference fields here, e.g., theme, last accessed context, etc.
  last_accessed_context_id   String?
  last_accessed_context_type String?

  user User @relation(fields: [user_id], references: [id])
}

model ContextAccess {
  id           String   @id @default(uuid())
  user_id      String
  context_type String
  context_id   String
  role         String
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])
}

// ─── FOUNDER ─────────────────────────────────────────────────────────
model Founder {
  id               String   @id @default(uuid())
  user_id          String?  @unique
  program_id       String
  startup_id       String?
  name             String
  email            String?
  phone            String?
  cpf              String?
  photo_url        String?
  role             String? // CEO, CTO, CMO, COO, outro
  bio              String?
  linkedin         String?
  instagram        String?
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  // Diagnóstico comportamental
  coachability     Float?   @default(0)
  execution_speed  Float?   @default(0)
  resilience       Float?   @default(0)
  leadership       Float?   @default(0)
  personality_type String? // Executor, Visionário, Analítico, Conector
  notes            String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  program Program @relation(fields: [program_id], references: [id])
  user    User?   @relation(fields: [user_id], references: [id])
}

// ─── STARTUP ENGAGEMENT ──────────────────────────────────────────────
model StartupEngagement {
  id                  String   @id @default(uuid())
  startup_id          String   @unique
  trail_participation Float?   @default(0) // % participação trilha
  library_usage       Float?   @default(0) // % uso biblioteca
  mentoring_presence  Float?   @default(0) // % presença mentoria
  training_presence   Float?   @default(0) // % presença capacitações
  events_count        Int?     @default(0) // nº eventos participados
  engagement_score    Float?   @default(0) // score geral 0-100
  updated_at          DateTime @updatedAt
}

// ─── STARTUP ACHIEVEMENT ─────────────────────────────────────────────
model StartupAchievement {
  id          String    @id @default(uuid())
  startup_id  String
  type        String // EVENTO, PREMIO, PUBLICACAO, PARCERIA, CONTRATO, INVESTIMENTO, EXPANSAO, OUTRO
  title       String
  description String?
  date        DateTime?
  link        String?
  media_url   String?
  created_at  DateTime  @default(now())
}

// ─── MENTORSHIP SESSION (detailed) ───────────────────────────────────
model MentorshipSession {
  id                       String   @id @default(uuid())
  startup_id               String
  program_id               String?
  mentor_name              String
  other_mentors            String? // JSON array of names
  conciliators             String? // JSON array
  trainer_name             String?
  mentoring_hours          Float    @default(0)
  training_hours           Float    @default(0)
  topics                   String? // JSON array
  // Feedbacks
  mentor_feedback          String?
  startup_mentor_feedback  String?
  startup_program_feedback String?
  main_needs               String?
  curations                String?
  session_date             DateTime @default(now())
  created_at               DateTime @default(now())
}

// ─── MATURITY ASSESSMENT ─────────────────────────────────────────────
model MaturityAssessment {
  id                   String    @id @default(uuid())
  startup_id           String
  program_id           String?
  // Critérios de classificação A/B/C
  deliveries_score     Int       @default(0) // 0-10
  engagement_score     Int       @default(0)
  has_cnpj             Boolean   @default(false)
  employees_count      Int       @default(0)
  active_contracts     Int       @default(0)
  sales_made           Boolean   @default(false)
  negotiation_capacity Int       @default(0) // 0-10
  evolution_score      Int       @default(0) // 0-10
  // Nível calculado
  maturity_level       String    @default("C") // A, B, C
  // Alcance
  territory_reach      String    @default("PARANA") // PARANA, BRASIL, INTERNACIONAL
  // Investimento
  received_investment  Boolean   @default(false)
  investment_amount    Float?
  investment_date      DateTime?
  investor_name        String?
  // Conquistas principais (JSON array)
  key_achievements     String?
  assessed_at          DateTime  @default(now())
  updated_at           DateTime  @updatedAt
}

// ─── LIBRARY ─────────────────────────────────────────────────────────
model LibraryItem {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String // COURSE, LINK, DOCUMENT
  url         String
  category    String? // e.g., 'Vendas', 'Marketing', 'Finanças'
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

// ─── CRM LEADS ───────────────────────────────────────────────────────
model Lead {
  id          String   @id @default(uuid())
  startup_id  String
  name        String
  email       String?
  phone       String?
  company     String?
  value       Float?   @default(0)
  status      String   @default("NEW") // NEW, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  source      String?  // Inbound, Outbound, Referral, etc.
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  startup Startup @relation(fields: [startup_id], references: [id])
}

// ─── AGENDA EVENTS ───────────────────────────────────────────────────
model AgendaEvent {
  id          String   @id @default(uuid())
  startup_id  String
  title       String
  description String?
  start_time  DateTime
  end_time    DateTime
  type        String   @default("MEETING") // MEETING, MENTORSHIP, PITCH, INTERNAL, EVENT
  location    String?
  link        String?
  attendees   String?  // Comma-separated names or IDs
  status      String   @default("SCHEDULED") // SCHEDULED, CANCELLED, DONE
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  startup Startup @relation(fields: [startup_id], references: [id])
}
